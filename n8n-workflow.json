{
  "name": "fead.app Email Handler",
  "nodes": [
    {
      "parameters": {
        "path": "fead-app-emails",
        "options": {}
      },
      "id": "webhook-start",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300],
      "webhookId": "fead-app-emails"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.type}}",
              "operation": "equal",
              "value2": "contact"
            }
          ]
        }
      },
      "id": "if-contact",
      "name": "If Contact Form",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.type}}",
              "operation": "equal",
              "value2": "demo"
            }
          ]
        }
      },
      "id": "if-demo",
      "name": "If Demo Request",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [460, 500]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "sendTo": "sadeq.aldallal@fead.app",
        "subject": "=[Contact Form] {{$json.formData.subject}}",
        "emailType": "html",
        "message": "=<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n  <h2 style=\"color: #22c55e;\">New Contact Form Submission</h2>\n  <div style=\"background: #f9f9f9; padding: 20px; border-radius: 8px; margin: 20px 0;\">\n    <p><strong>Name:</strong> {{$json.formData.name}}</p>\n    <p><strong>Email:</strong> {{$json.formData.email}}</p>\n    <p><strong>Subject:</strong> {{$json.formData.subject}}</p>\n    <p><strong>Message:</strong></p>\n    <div style=\"background: white; padding: 15px; border-radius: 4px; border-left: 4px solid #22c55e;\">\n      {{$json.formData.message}}\n    </div>\n  </div>\n  <p style=\"color: #666; font-size: 12px;\">Sent from fead.app contact form at {{$json.timestamp}}</p>\n</div>",
        "options": {
          "replyTo": "={{$json.formData.email}}"
        }
      },
      "id": "contact-notification",
      "name": "Send Contact Notification",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 1,
      "position": [680, 200]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "sendTo": "={{$json.formData.email}}",
        "subject": "Thank you for contacting fead.app",
        "emailType": "html",
        "message": "=<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px;\">\n  <img src=\"https://fead.app/fead.app_logo.png\" alt=\"fead.app\" style=\"height: 40px; margin-bottom: 20px;\">\n  <div style=\"background: linear-gradient(135deg, #1e293b 0%, #334155 100%); color: white; padding: 30px; border-radius: 12px;\">\n    <p>Dear {{$json.formData.name}},</p>\n    <p>Thank you for contacting fead.app! We've received your message and appreciate you reaching out to us.</p>\n    <p>Our team will review your inquiry and respond within 24 hours during business hours. We're committed to providing you with the best possible assistance.</p>\n    <p>In the meantime, feel free to explore our website to learn more about how our AI-powered Instagram customer support solution can transform your business communications.</p>\n    <p>If you have any urgent questions, please don't hesitate to reach out again.</p>\n    <p>Best regards,<br>The fead.app Team</p>\n    <hr style=\"border: none; border-top: 1px solid rgba(255,255,255,0.2); margin: 20px 0;\">\n    <p style=\"font-size: 12px; opacity: 0.8;\">This is an automated response. Please do not reply to this email.<br>fead.app - Transforming Instagram Customer Support with AI</p>\n  </div>\n</div>"
      },
      "id": "contact-auto-reply",
      "name": "Send Contact Auto-Reply",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 1,
      "position": [900, 200]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "sendTo": "sadeq.aldallal@fead.app",
        "subject": "=[Demo Request] {{$json.formData.company}}",
        "emailType": "html",
        "message": "=<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n  <h2 style=\"color: #22c55e;\">New Demo Request</h2>\n  <div style=\"background: #f9f9f9; padding: 20px; border-radius: 8px; margin: 20px 0;\">\n    <p><strong>Name:</strong> {{$json.formData.name}}</p>\n    <p><strong>Email:</strong> {{$json.formData.email}}</p>\n    <p><strong>Company:</strong> {{$json.formData.company}}</p>\n    <p><strong>Message:</strong></p>\n    <div style=\"background: white; padding: 15px; border-radius: 4px; border-left: 4px solid #22c55e;\">\n      {{$json.formData.message}}\n    </div>\n  </div>\n  <div style=\"background: #22c55e; color: white; padding: 15px; border-radius: 8px; text-align: center;\">\n    <strong>🎯 High Priority: Demo Request</strong>\n    <p style=\"margin: 5px 0 0 0; font-size: 14px;\">Follow up within 24 hours</p>\n  </div>\n  <p style=\"color: #666; font-size: 12px;\">Sent from fead.app demo request form at {{$json.timestamp}}</p>\n</div>",
        "options": {
          "replyTo": "={{$json.formData.email}}"
        }
      },
      "id": "demo-notification",
      "name": "Send Demo Notification",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 1,
      "position": [680, 400]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "sendTo": "={{$json.formData.email}}",
        "subject": "Your fead.app Demo Request Received",
        "emailType": "html",
        "message": "=<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px;\">\n  <img src=\"https://fead.app/fead.app_logo.png\" alt=\"fead.app\" style=\"height: 40px; margin-bottom: 20px;\">\n  <div style=\"background: linear-gradient(135deg, #1e293b 0%, #334155 100%); color: white; padding: 30px; border-radius: 12px;\">\n    <p>Dear {{$json.formData.name}},</p>\n    <p>Thank you for your interest in fead.app! We're excited that {{$json.formData.company}} is considering our AI-powered Instagram customer support solution.</p>\n    <p>We've received your demo request and our team will be in touch within 24 hours to:</p>\n    <ul>\n      <li>Schedule a personalized demo session</li>\n      <li>Discuss your specific Instagram support needs</li>\n      <li>Show you how our AI can transform your customer interactions</li>\n      <li>Answer any questions about implementation and pricing</li>\n    </ul>\n    <p><strong>What you can expect in our demo:</strong></p>\n    <ul>\n      <li>✓ Live demonstration of AI-powered response automation</li>\n      <li>✓ Integration walkthrough with Instagram Business accounts</li>\n      <li>✓ Custom solution tailored to your business needs</li>\n      <li>✓ ROI analysis and implementation timeline</li>\n    </ul>\n    <p>We're looking forward to showing you how fead.app can revolutionize your customer support experience!</p>\n    <p>Best regards,<br>The fead.app Team<br>Sadeq Aldallal<br>sadeq.aldallal@fead.app</p>\n    <hr style=\"border: none; border-top: 1px solid rgba(255,255,255,0.2); margin: 20px 0;\">\n    <p style=\"font-size: 12px; opacity: 0.8;\">This is an automated response. Please do not reply to this email.<br>fead.app - Transforming Instagram Customer Support with AI</p>\n  </div>\n</div>"
      },
      "id": "demo-auto-reply",
      "name": "Send Demo Auto-Reply",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 1,
      "position": [900, 400]
    }
  ],
